# Copy to .env and fill in. Only read by the Node server (dev, preview, .output/server).

# Enables the Claude-written "Coach's review" in the Trading journal.
# Without it the app falls back to the built-in heuristic review.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: where the cross-device journal mirror is written.
# Defaults to ~/.pnl-calendar/state.json
# PNL_DATA_DIR=
